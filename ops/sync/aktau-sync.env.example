# Copy to /etc/aktau-sync.env (chmod 600, owner aktau-sync). Fill the empty values; never commit real ones.
APP_ENV=production
INGEST_DATABASE_URL=
INGEST_MAX_STORE_DROP_PERCENT=10
INGEST_PRODUCTION_APPLY_CONFIRM=1
SYNC_STORES=MAGNUM,GRAMAD
FRONTEND_REVALIDATE_URL=https://aktau.market/internal/revalidate
REVALIDATE_HMAC_SECRET=
# Очистка старых snapshot после публикации (необязательно). Пусто — очистка пропускается.
# Строка подключения роли aktau_retention_writer (session pooler, порт 5432), не INGEST_DATABASE_URL.
RETENTION_DATABASE_URL=
RETENTION_KEEP_SNAPSHOTS=14
RETENTION_PRODUCTION_APPLY_CONFIRM=1
