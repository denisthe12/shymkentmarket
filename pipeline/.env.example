# Скрапер Magnum не требует секретов и ключей; лимиты задаются необязательными SCRAPE_* env.

# Gramad scraper: request headers as a JSON object; required, values are kept out of git.
GRAMAD_REQUEST_HEADERS=

# F-Mart scraper: request headers as a JSON object; required, values are kept out of git.
FMART_REQUEST_HEADERS=
